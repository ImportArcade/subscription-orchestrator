generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  displayName      String? 
  timezone         String? 
  preferredChannels Json?  
  provider         String
  providerId       String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([provider, providerId])
}
